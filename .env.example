# SOLVENT runs entirely on-device and needs NO secrets to function.
# There is no backend, no API key, and no analytics key. Nothing leaves the phone.
#
# The values below are only for OPTIONAL production add-ons documented in
# zero-to-deploy.md. They are public client keys (safe to ship in the bundle),
# never private secrets. Real secrets, if you ever add a backend, go in EAS
# secrets / expo-secure-store, never here and never in source.

# RevenueCat public SDK keys (only if you wire live Pro billing).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
